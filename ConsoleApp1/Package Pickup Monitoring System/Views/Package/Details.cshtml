@model Package_Pickup_Monitoring_System.Models.Package
@{ ViewData["Title"] = "Package Details"; }

<h2>Package Details</h2>
<hr />
<div class="card">
    <div class="card-header bg-primary text-white">
        Tracking #: @Model.TrackingNumber
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Recipient</dt>
            <dd class="col-sm-9">@Model.RecipientName</dd>

            <dt class="col-sm-3">Unit / Office</dt>
            <dd class="col-sm-9">@Model.UnitNumber</dd>

            <dt class="col-sm-3">Contact Number</dt>
            <dd class="col-sm-9">@Model.ContactNumber</dd>

            <dt class="col-sm-3">Courier</dt>
            <dd class="col-sm-9">@Model.CourierCompany</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.PackageType</dd>

            <dt class="col-sm-3">Arrival Date & Time</dt>
            <dd class="col-sm-9">@Model.ArrivalDateTime.ToString("f")</dd>

            <dt class="col-sm-3">Expected Pickup</dt>
            <dd class="col-sm-9">@(Model.ExpectedPickupDate?.ToString("d") ?? "-")</dd>

            <dt class="col-sm-3">Claimed Date & Time</dt>
            <dd class="col-sm-9">@(Model.ClaimedDateTime?.ToString("f") ?? "-")</dd>

            <dt class="col-sm-3">Received By</dt>
            <dd class="col-sm-9">@Model.ReceivedBy</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Notes) ? "None" : Model.Notes)</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>